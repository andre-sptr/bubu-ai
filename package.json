{
  "name": "bubu-whatsapp-agent",
  "version": "2.4.0",
  "private": true,
  "description": "Clean rebuild of Bubu WhatsApp personal AI agent",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test \"test/integration/**/*.test.js\"",
    "test:contracts": "node --test \"test/contracts/**/*.test.js\"",
    "check": "node scripts/check-syntax.js && npm test",
    "models": "node scripts/list-models.js",
    "backup": "node scripts/backup.js",
    "test:phase1": "bash scripts/phase1-regression.sh",
    "test:phase2": "bash scripts/phase2-regression.sh",
    "test:phase3": "bash scripts/phase3-regression.sh",
    "test:phase4": "bash scripts/phase4-regression.sh",
    "test:phase5": "bash scripts/phase5-regression.sh",
    "test:phase6": "bash scripts/phase6-regression.sh"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.11.1",
    "docx": "^9.15.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "mammoth": "^1.13.0",
    "pdf-parse": "^1.1.4",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {},
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
