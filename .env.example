# Bubu — minimal production configuration
NODE_ENV=production

# WhatsApp / WAHA
OWNER_JID=628xxxxxxxxxx@c.us
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_SESSION=default
WAHA_WEBHOOK_TOKEN=replace-with-a-long-random-secret
# Optional: set only if WAHA API authentication is enabled.
WAHA_API_KEY=

# AI provider
SUMOPOD_API_KEY=

# -----------------------------------------------------------------------------
# Optional HTTP server, storage, and backup settings
# -----------------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=3088
# LOG_LEVEL=info
# DATABASE_PATH=./data/bubu.sqlite
# STORAGE_DIR=./storage
# BACKUP_DIR=./backups

# -----------------------------------------------------------------------------
# Optional WAHA hardening, timeouts, and group routing
# -----------------------------------------------------------------------------
# BOT_JID=
# WAHA_WEBHOOK_HEADER=x-webhook-token
# WAHA_WEBHOOK_HMAC_SECRET=
# WAHA_TIMEOUT_MS=15000
# WAHA_MEDIA_TIMEOUT_MS=60000
# WAHA_TYPING_KEEPALIVE_MS=12000
# GROUP_POLICY=all
# GROUP_REQUIRE_MENTION=true
# GROUP_MEDIA_REQUIRE_MENTION=false
# GROUP_PROACTIVE_ENABLED=false

# -----------------------------------------------------------------------------
# Optional web search (Tavily)
# -----------------------------------------------------------------------------
# TAVILY_API_KEY=
# WEB_SEARCH_MAX_RESULTS=5

# -----------------------------------------------------------------------------
# Optional Sumopod & model overrides
# -----------------------------------------------------------------------------
# SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
# SUMOPOD_TIMEOUT_MS=60000
# MODEL_FAST=claude-haiku-5-5
# MODEL_BALANCED=claude-sonnet-5-5
# MODEL_REASONING=claude-opus-5-5
# MODEL_CODING=claude-sonnet-5-5
# MODEL_SUMMARY=gemini/gemini-3.1-pro-preview
# MODEL_VISION=claude-sonnet-5-5

# -----------------------------------------------------------------------------
# Optional document & OCR limits
# -----------------------------------------------------------------------------
# MAX_DOCUMENT_BYTES=15728640
# MAX_DOCUMENT_CHARS=50000
# DOCUMENT_OCR_ENABLED=true
# MAX_PDF_OCR_PAGES=10
# PDF_RENDER_DPI=150
# PDFTOPPM_BIN=pdftoppm
# GHOSTSCRIPT_BIN=gs

# -----------------------------------------------------------------------------
# Optional media, vision, Whisper STT, and Piper TTS overrides
# -----------------------------------------------------------------------------
# MEDIA_INTELLIGENCE_ENABLED=true
# MEDIA_VISION_ENABLED=true
# MAX_MEDIA_BYTES=26214400
# MAX_VISION_IMAGE_BYTES=4194304
# MAX_VISION_IMAGE_DIMENSION=1280
# MAX_AUDIO_SECONDS=900
# MAX_VIDEO_SECONDS=180
# MAX_VIDEO_FRAMES=8
# TESSERACT_BIN=tesseract
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# WHISPER_BIN=/opt/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL_PATH=/opt/whisper.cpp/models/ggml-base.bin
# WHISPER_LANGUAGE=auto
# WHISPER_VAD_MODEL_PATH=/opt/whisper.cpp/models/ggml-silero-v6.2.0.bin
# PIPER_BIN=/opt/piper-venv/bin/piper
# PIPER_MODEL_PATH=/opt/piper-voices/id_ID-news_tts-medium.onnx
# VOICE_REPLY_DEFAULT=false

# -----------------------------------------------------------------------------
# Optional inbox worker, agent budgets, and rate limiting
# -----------------------------------------------------------------------------
# INBOX_POLL_MS=500
# INBOX_MAX_ATTEMPTS=5
# INBOX_STALE_MS=120000
# AGENT_ENABLED=true
# AGENT_MAX_ROUNDS=5
# AGENT_MAX_TOOL_CALLS=8
# AGENT_MAX_TOOL_RESULT_CHARS=12000
# AGENT_MAX_OUTPUT_TOKENS=4096
# AGENT_TASK_TIMEOUT_MS=90000
# AGENT_TOOL_TIMEOUT_MS=15000
# AGENT_MAX_CONCURRENT_JOBS=1
# MESSAGE_RATE_LIMIT=10
# MESSAGE_RATE_WINDOW_MS=60000
# APPROVAL_TTL_MINUTES=5
